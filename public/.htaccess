Options -MultiViews
DirectoryIndex index.html

# Security response headers for the static site. LiteSpeed supports Apache's
# mod_headers directives; the conditional prevents an unsupported host from
# returning a configuration error.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp|css|js|woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Preserve links to the previous URL that contained an ampersand.
RewriteRule ^treatments/skin-conditions/Wart&MoleCare/?$ /treatments/skin-conditions/wart-mole-care/ [R=301,L,NE]

# Use the same non-www host as the sitemap and canonical URLs.
# REQUEST_URI preserves the path; the original query string is retained.
RewriteCond %{HTTP_HOST} ^www\.oswaljainskinclinic\.com$ [NC]
RewriteRule ^ https://oswaljainskinclinic.com%{REQUEST_URI} [R=301,L]

# Serve Next.js static-export pages from their matching .html files.
# This also works when a route has an accompanying data directory.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
